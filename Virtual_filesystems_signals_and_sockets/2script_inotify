
#The Problem: Build an event-driven directory watcher for /tmp/raw_uploads. 
#Whenever a new .png or .jpg image is created or moved into the directory, extract the filename, output "[INGEST] Processing <filename>", 
#and move the file into /tmp/media_library/.

#!/bin/bash
set -euo pipefail

WATCH_DIRECTORY="/tmp/raw_uploads"
TARGET_DIRECTORY="/tmp/media_library"

mkdir -p "$WATCH_DIRECTORY" "$TARGET_DIRECTORY"

inotifywait -m -e create -e moved_to --format "%w%f" "$WATCH_DIRECTORY" | while read -r FILENAME; do
    echo "[INGEST] Processing "$FILENAME"
    if [["$FILENAME" == *.png || "$FILENAME" == *.jpg ]]; then
        mv "$FILENAME" "$TARGET_DIRECTORY"
    fi
   
done