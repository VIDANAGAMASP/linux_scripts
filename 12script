#Application: Used in production CI/CD deployment scripts to ensure broken config files are automatically restored.

#Challenge 12: Safe Environment File Updater

#    Based on Script 12: Safe File Backup with Automatic Rollback (safe_deploy.sh)

#    Concepts Tested: set -e, trap ... ERR, configuration backups with cp, automatic error rollback.

#    The Problem: Write a script that updates a configuration file settings.env. Create a backup settings.env.bak before making changes. Register an ERR trap that restores the backup file if any command fails during execution. Append a new string FEATURE_FLAG=enabled to settings.env, and delete the backup file upon success.

#!/bin/bash
set -e

CONFIG_FILE="./config"
BACKUP_FILE="./config.bak"

rollback(){
    echo "Error detected during update"
    if [-f BACKUP_FILE]; then
        cp "$BACKUP_FILE" "$CONFIG_FILE"
        echo "Restored original config file."
    fi
}
trap rollback ERR

cp "$CONFIG_FILE" "$BACKUP_FILE"
echo "HELLO SANKA IDIOT" > "$CONFIG_FILE"

rm -f "$BACKUP_FILE"



