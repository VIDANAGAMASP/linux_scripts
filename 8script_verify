#The Problem: Write a deployment pre-check script that verifies if docker, kubectl, helm, and git are installed on the local system using command -v. Iterate through the list, report missing tools, and exit with status code 1 if at least one tool is missing.

#!/bin/bash
set -euo pipefail

REQUIRED_TOOLS=(
    "docker"
    "kubectl"
    "helm"
    "git"
)

for i in ${REquired_TOOLS[@]};
do
    if [! command -v "$i" > /dev/null 2&1];
    then
        echo "Required utility "$i" missing"
    else
        echo "found $(command -v "$i")"
    fi
done

