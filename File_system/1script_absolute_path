#Script to resolve relative path to absolute path

#!/bin/bash
set -euo pipefail
file_path=${1:-./file/file.txt}

if [[ "$file_path" =~ ^/ ]]; then
    echo "path is already absolute"
    abs_path= "$file_path"
else
    echo "relative path"
    abs_path="$(cd "$(dirname "$file_path")" 2>/dev/null && pwd)/$(basename "$file_path")"
fi

echo "absolute path is $abs_path"

#With this script can execute anywhere but should handle cd errors lest it affect subsequent commands. The script uses the dirname command to extract the directory portion of the file path and then changes to that directory using cd. The pwd command is used to get the absolute path of the current working directory, which is then combined with the basename of the file path to construct the absolute path. The script also includes error handling to ensure that any errors encountered during the cd command do not affect subsequent.
