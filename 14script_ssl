#   The Problem: Write a script that connects to github.com on port 443 using openssl. Extract its certificate expiration date, convert both the expiration date and current time to Epoch seconds, calculate the days remaining, and print a warning if the certificate expires in less than 60 days.

#!/bin/bash
DOMAIN="github.com"
PORT=443

EXP_DATE=$(echo | openssl s_client -servername "$DOMAIN" -connect "${DOMAIN}:${PORT}" 2>/dev/null | openssl x509 -noout -enddate | cut -d= -f2)

EXP_EPOCH=$(date -d "$EXP_DATE" +%s)
NOW_EPOCH=$(date +%s)
DAYS_LEFT=$(( (EXP_EPOCH - NOW_EPOCH) / 86400 ))

if [DAYS_LEFT -lt 60]; then 
    echo "[ALERT] Certificate for $DOMAIN expires in less than 60 days!"
else
    echo "Certificate for $DOMAIN is valid for $DAYS_LEFT days."
fi