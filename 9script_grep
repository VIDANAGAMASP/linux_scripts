#    The Problem: Write a script that accepts an authentication log path as an argument (defaulting to /var/log/auth.log). Verify the file exists. Count and display the number of occurrences for these case-insensitive security events: "Failed", "Accepted", "Invalid", and "sudo".

#!/bin/bash
LOGFILE="${1:-/var/log/auth.log}"

if [ ! -f $LOGFILE ]; then
    echo "file doesnt exist"
    exit 1
fi

for i in "Failed" "Accepted" "Invalid" "sudo"
do
    Counter=$(grep -c -i "$i" "$LOGFILE" || true)
    echo "$i count: $Counter"
done


